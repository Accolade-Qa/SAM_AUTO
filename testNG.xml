<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!-- 
	TestNG Configuration for Sampark Automation Suite
	
	PARALLEL EXECUTION SETTINGS:
	- parallel="classes": Run multiple test classes in parallel
	- thread-count="4": Maximum 4 threads can run simultaneously at TestNG level
	  NOTE: ThreadQueueManager further controls concurrent execution to prevent resource exhaustion
	  
	EXECUTION FLOW:
	1. TestNG spawns up to 4 threads
	2. Each thread attempts to run a test class
	3. ThreadQueueManager restricts actual execution to defined capacity (default: 4)
	4. When a thread finishes, the next waiting thread acquires a slot
	5. This prevents resource exhaustion and ensures stable parallel execution
	
	preserve-order="true": Maintain the order of test classes/methods as defined
-->
<suite name="AllTestSuite" verbose="1" preserve-order="true"
	parallel="tests" thread-count="4">
	<listeners>
		<listener class-name="com.aepl.sam.listeners.TestListener" />
		<listener class-name="com.aepl.sam.listeners.Transformer" />
		<listener class-name="com.aepl.sam.listeners.ProjectFilterInterceptor" />
	</listeners>

	<test name="ALLTests" enabled="true">
		<classes>
			<class name="com.aepl.sam.tests.LoginPageTest" />
			<class name="com.aepl.sam.tests.DeviceDashboardPageTest" />
			<class name="com.aepl.sam.tests.DeviceDetailsPageTest" />
			<class name="com.aepl.sam.tests.DeviceModelsPageTest" />
			<class name="com.aepl.sam.tests.GovernmentServerPageTest" />
			<class name="com.aepl.sam.tests.FotaPageTest" />
			<class name="com.aepl.sam.tests.ProductionDevicePageTest" /> 
			<class name="com.aepl.sam.tests.DispatchedDevicesPageTest" />
			<class name="com.aepl.sam.tests.OtaPageTest" />
			<class name="com.aepl.sam.tests.CustomerMasterPageTest" />
			<class name="com.aepl.sam.tests.SimBatchDataDetailsPageTest" />
			<class name="com.aepl.sam.tests.UserManagementPageTest" />
			<class name="com.aepl.sam.tests.GroupManagementPageTest" />
			<class name="com.aepl.sam.tests.RoleManagementPageTest" />
			<class name="com.aepl.sam.tests.DealersManagementPageTest" />
			<class name="com.aepl.sam.tests.UserProfilePageTest" />
		</classes>
	</test>
</suite>
