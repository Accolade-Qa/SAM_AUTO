<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!-- 
	TestNG Configuration for Sampark REST Assured API Suite
-->
<suite name="ApiTestSuite" verbose="1" preserve-order="true">
	<listeners>
		<listener class-name="com.aepl.sam.listeners.TestListener" />
		<listener class-name="com.aepl.sam.listeners.Transformer" />
	</listeners>

	<test name="REST_Assured_API_Tests" enabled="true">
		<classes>
			<class name="com.aepl.sam.tests.api.AuthApiTest" />
		</classes>
	</test>
</suite>
