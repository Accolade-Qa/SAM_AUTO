<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!-- 
	TestNG Configuration for Sampark Smoke Test Suite
	Executes critical sanity and core functionality tests.
-->
<suite name="SmokeTestSuite" verbose="1" preserve-order="true" parallel="classes" thread-count="2">
	<listeners>
		<listener class-name="com.aepl.sam.listeners.TestListener" />
		<listener class-name="com.aepl.sam.listeners.Transformer" />
		<listener class-name="com.aepl.sam.listeners.ProjectFilterInterceptor" />
	</listeners>

	<test name="Smoke_Tests" enabled="true">
		<classes>
			<class name="com.aepl.sam.tests.LoginPageTest" />
			<class name="com.aepl.sam.tests.DeviceDashboardPageTest" />
			<class name="com.aepl.sam.tests.api.AuthApiTest" />
		</classes>
	</test>
</suite>
